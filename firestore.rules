rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/progress/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    // Problems / topics / patterns: public read (browsing without sign-in), authenticated write
    match /problems/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /topics/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /patterns/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /problemOverrides/{docId} {
      allow read, write: if request.auth != null;
    }
    match /progress/{docId} {
      allow read, write: if false;
    }
    match /users/{userId}/notes/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/notesIndex/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
