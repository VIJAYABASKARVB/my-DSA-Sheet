rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User progress + spaced repetition: only owner can read/write
    // Spaced repetition fields (recallStatus, lastReviewedAt, nextReviewAt, reviewCount)
    // are stored as merged fields in the same doc via increment/serverTimestamp
    match /users/{uid}/progress/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // Problems / topics / patterns: public read (browsing without sign-in), authenticated write
    match /problems/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /topics/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /patterns/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Global overrides: auth-only (single user). If multi-user later, migrate to users/{uid}/overrides
    match /problemOverrides/{docId} {
      allow read, write: if request.auth != null;
    }

    // Legacy global progress (pre-uid migration) - deny, force per-user
    match /progress/{docId} {
      allow read, write: if false;
    }
  }
}
